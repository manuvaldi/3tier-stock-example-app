worker_processes auto;
events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    client_body_temp_path /tmp/client_body;
    proxy_temp_path       /tmp/proxy_temp;
    fastcgi_temp_path     /tmp/fastcgi_temp;
    uwsgi_temp_path       /tmp/uwsgi_temp;
    scgi_temp_path        /tmp/scgi_temp;

    sendfile        on;
    keepalive_timeout  65;

    include /tmp/nginx-upstream.conf;

    server {
        listen       8080;
        server_name  localhost;

        location / {
            root   /usr/share/nginx/html;
            index  index.html index.htm;
        }

        # Proxy al backend interno (failover / reintentos entre servidores del upstream)
        location /data {
            proxy_pass http://backends;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;

            # Cabeceras de respuesta añadidas por nginx (el backend puede añadir las suyas aparte)
            add_header X-Upstream-Addr $upstream_addr always;
            add_header X-Hostname     $hostname always;

            proxy_next_upstream error timeout http_502 http_503 http_504;
            proxy_next_upstream_tries 5;

            # Timeouts agresivos para la demo
            proxy_connect_timeout 1s;
            proxy_send_timeout    1s;
            proxy_read_timeout    1s;

            proxy_intercept_errors on;
            error_page 502 503 504 =503 /error_handler;
        }
        location = /error_handler {
            default_type application/json;
            add_header X-Hostname $hostname always;
            return 503 '{"error": "backend_migrating"}';
        }
    }
}
